# WiseHer Environment Variables
# Copy this file to .env and fill in your keys.

# Required for AI-powered Relationship Twin and Pattern checks
# Get a key at: https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# Optional: Anymize API Key for external PII anonymization
# If left empty, WiseHer automatically uses its built-in local privacy anonymizer
VITE_ANYMIZE_API_KEY=
